# CodeBuddy2API 本地服务配置（不入库）
# 服务访问密码（客户端 Bearer Token）
CODEBUDDY_PASSWORD=xxxx

# 认证模式：api_key = 直接使用 CodeBuddy API Key（无需 OAuth 凭证）
CODEBUDDY_AUTH_MODE=api_key
CODEBUDDY_API_KEY=ck_xxxx-xx

# 中国版（内网）环境 → 官方端点 https://copilot.tencent.com
CODEBUDDY_INTERNET_ENVIRONMENT=internal

CODEBUDDY_HOST=127.0.0.1
CODEBUDDY_PORT=8001
CODEBUDDY_LOG_LEVEL=INFO

# 真实可用模型（来自 CodeBuddy 上游发现，参考 Go 代理 /v1/models）
CODEBUDDY_MODELS=glm-5.3,glm-5.3-flash,glm-5.2,glm-5.1,hy4-preview,hy3,hy3-x,glm-5v-turbo,minimax-m3-pay,minimax-m2.7,kimi-k3-2,kimi-k2.7,kimi-k2.6,deepseek-v4-pro,deepseek-v4-flash
